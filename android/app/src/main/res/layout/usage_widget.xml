<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/score_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_background">
    <ImageView
        android:id="@+id/widget_mood_icon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_mood_description"
        android:src="@drawable/vui" />
    <TextView
        android:id="@+id/widget_mood_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/widget_quote_vui"
        android:textColor="#392B27"
        android:textSize="13sp"
        android:textStyle="bold"
        android:breakStrategy="simple"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
